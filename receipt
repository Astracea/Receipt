<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Retro Receipt Generator Pro</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js">
    </script>
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js">
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=VT323&family=Share+Tech+Mono&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #0a0a12;
            --bg-panel: #12121e;
            --bg-input: #1a1a2e;
            --text-primary: #e0e0e0;
            --text-accent: #7fff7f;
            --text-accent-amber: #ffbf40;
            --border-glow: #2a2a4a;
            --border-focus: #00ff88;
            --btn-primary: #00cc66;
            --btn-primary-hover: #00ee77;
            --btn-danger: #e74c3c;
            --btn-danger-hover: #ff5e4d;
            --btn-warning: #f0a030;
            --btn-warning-hover: #ffbb44;
            --btn-info: #3498db;
            --btn-info-hover: #4aa3df;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Share Tech Mono', 'Courier New', monospace;
            background: var(--bg-dark);
            color: var(--text-primary);
            min-height: 100vh;
            overflow-x: hidden;
            background-image:
                radial-gradient(ellipse at 20% 50%, rgba(20, 20, 50, 0.8) 0%, transparent 60%),
                radial-gradient(ellipse at 80% 20%, rgba(30, 10, 40, 0.6) 0%, transparent 50%),
                radial-gradient(ellipse at 50% 80%, rgba(10, 30, 20, 0.5) 0%, transparent 50%);
        }

        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 9999;
            background: repeating-linear-gradient(0deg,
                    rgba(0, 0, 0, 0.03) 0px,
                    rgba(0, 0, 0, 0.03) 1px,
                    transparent 1px,
                    transparent 3px);
        }

        .site-header {
            text-align: center;
            padding: 30px 20px 10px;
        }

        .site-header h1 {
            font-family: 'VT323', 'Courier New', monospace;
            font-size: 3rem;
            font-weight: 400;
            letter-spacing: 4px;
            color: var(--text-accent);
            text-shadow: 0 0 15px rgba(127, 255, 127, 0.4), 0 0 40px rgba(127, 255, 127, 0.15);
            margin-bottom: 5px;
        }

        .site-header .subtitle {
            font-size: 0.85rem;
            color: #8888aa;
            letter-spacing: 3px;
            text-transform: uppercase;
        }

        .site-header .subtitle span {
            color: var(--text-accent-amber);
            animation: blink 1.2s step-end infinite;
        }

        @keyframes blink {
            0%,
            100% {
                opacity: 1;
            }
            50% {
                opacity: 0;
            }
        }

        .main-container {
            display: flex;
            gap: 30px;
            padding: 20px 30px 40px;
            max-width: 1400px;
            margin: 0 auto;
            align-items: flex-start;
        }

        .form-panel {
            flex: 1;
            min-width: 0;
            background: var(--bg-panel);
            border: 1px solid var(--border-glow);
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
        }

        .form-panel h2 {
            font-family: 'VT323', 'Courier New', monospace;
            font-size: 1.6rem;
            font-weight: 400;
            color: var(--text-accent);
            letter-spacing: 2px;
            margin-bottom: 20px;
            border-bottom: 1px dashed #333;
            padding-bottom: 10px;
        }

        .form-section {
            margin-bottom: 18px;
        }

        .form-section label {
            display: block;
            font-size: 0.7rem;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: #9999bb;
            margin-bottom: 5px;
        }

        .form-section input,
        .form-section select,
        .form-section textarea {
            width: 100%;
            padding: 10px 14px;
            background: var(--bg-input);
            border: 1px solid var(--border-glow);
            border-radius: 6px;
            color: var(--text-primary);
            font-family: 'Share Tech Mono', 'Courier New', monospace;
            font-size: 0.85rem;
            transition: all 0.3s ease;
            outline: none;
        }

        .form-section input:focus,
        .form-section select:focus,
        .form-section textarea:focus {
            border-color: var(--border-focus);
            box-shadow: 0 0 12px rgba(0, 255, 136, 0.2);
        }

        .form-section textarea {
            resize: vertical;
            min-height: 60px;
        }

        .form-row {
            display: flex;
            gap: 12px;
        }

        .form-row .form-section {
            flex: 1;
        }

        .btn {
            padding: 10px 18px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-family: 'Share Tech Mono', 'Courier New', monospace;
            font-size: 0.8rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-primary {
            background: var(--btn-primary);
            color: #0a0a12;
            font-weight: bold;
        }
        .btn-primary:hover {
            background: var(--btn-primary-hover);
            box-shadow: 0 0 20px rgba(0, 204, 102, 0.4);
        }

        .btn-danger {
            background: transparent;
            border: 1px solid var(--btn-danger);
            color: var(--btn-danger);
        }
        .btn-danger:hover {
            background: var(--btn-danger);
            color: #fff;
        }

        .btn-warning {
            background: transparent;
            border: 1px solid var(--btn-warning);
            color: var(--btn-warning);
        }
        .btn-warning:hover {
            background: var(--btn-warning);
            color: #0a0a12;
        }

        .btn-info {
            background: var(--btn-info);
            color: white;
        }
        .btn-info:hover {
            background: var(--btn-info-hover);
            box-shadow: 0 0 15px rgba(52, 152, 219, 0.4);
        }

        .btn-sm {
            padding: 7px 12px;
            font-size: 0.7rem;
        }

        .btn-group {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 10px;
        }

        .receipt-panel {
            flex: 0 0 380px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 15px;
        }

        .receipt-panel h3 {
            font-family: 'VT323', 'Courier New', monospace;
            font-size: 1.3rem;
            font-weight: 400;
            color: #8888aa;
            letter-spacing: 2px;
        }

        /* RECEIPT STYLES - Blending both designs */
        #receiptContainer {
            background: transparent;
            width: 100%;
            max-width: 340px;
            position: relative;
            transition: all 0.3s ease;
        }

        #receipt {
            width: 320px;
            background: #fff;
            padding: 20px 18px;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(255, 255, 255, 0.05);
            color: #000;
            font-family: 'Share Tech Mono', 'Courier New', monospace;
            font-size: 12px;
            line-height: 1.5;
            letter-spacing: 0.5px;
            margin: 0 auto;
            min-height: 400px;
        }

        /* Receipt color schemes */
        #receipt.scheme-classic {
            background: #faf8f2;
            color: #1a1a1a;
        }
        #receipt.scheme-inverted {
            background: #111;
            color: #eee;
        }
        #receipt.scheme-blue {
            background: #f0f4ff;
            color: #003366;
        }
        #receipt.scheme-green {
            background: #0a1a0a;
            color: #33ff66;
        }
        #receipt.scheme-amber {
            background: #1a0e00;
            color: #ffbf40;
        }
        #receipt.scheme-pink {
            background: #1a0a12;
            color: #ff66aa;
        }

        .center {
            text-align: center;
        }
        .header {
            margin-bottom: 15px;
        }
        .logo {
            max-width: 120px;
            max-height: 80px;
            margin-bottom: 8px;
            object-fit: contain;
        }
        .logo-placeholder {
            display: block;
            border: 1px dashed #aaa;
            padding: 10px;
            font-size: 0.6rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 8px;
            border-radius: 3px;
        }
        .mono-header {
            font-family: 'VT323', 'Courier New', monospace;
            font-size: 20px;
            font-weight: 400;
            letter-spacing: 3px;
            line-height: 1.2;
            text-transform: uppercase;
        }
        .divider {
            border-top: 1px dashed currentColor;
            margin: 8px 0;
        }
        .row {
            display: flex;
            justify-content: space-between;
            margin: 2px 0;
        }
        .item-row {
            display: flex;
            justify-content: space-between;
            margin: 3px 0;
        }
        .total-row {
            display: flex;
            justify-content: space-between;
            font-weight: bold;
            font-size: 14px;
            margin-top: 5px;
        }
        .spacer {
            height: 12px;
        }
        .spacer-sm {
            height: 5px;
        }
        .barcode-area {
            margin-top: 15px;
            text-align: center;
        }
        .barcode-svg {
            max-width: 100%;
            height: 50px;
        }
        .barcode-text {
            font-size: 0.6rem;
            letter-spacing: 2px;
            margin-top: 2px;
        }
        .tip-line {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
        }
        .signature {
            display: flex;
            justify-content: space-between;
            margin-top: 30px;
            gap: 10px;
        }
        .signature span {
            white-space: nowrap;
        }
        .footer {
            margin-top: 15px;
            text-align: center;
        }
        .footer div {
            margin: 2px 0;
        }
        .asterisk-line {
            font-family: 'VT323', 'Courier New', monospace;
            letter-spacing: 4px;
            text-align: center;
            font-size: 14px;
            user-select: none;
        }
        .dash-line {
            letter-spacing: 2px;
            text-align: center;
            user-select: none;
            overflow: hidden;
            white-space: nowrap;
        }

        .print-toolbar {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .logo-preview {
            margin-top: 5px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .logo-preview img {
            max-height: 40px;
            max-width: 100px;
            object-fit: contain;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 4px;
            padding: 3px;
        }

        .toast {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            background: #222233;
            color: white;
            padding: 12px 24px;
            border-radius: 8px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.85rem;
            letter-spacing: 1px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
            z-index: 99999;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.4s ease;
            border: 1px solid #444;
        }
        .toast.show {
            opacity: 1;
        }

        @media (max-width: 1100px) {
            .main-container {
                flex-direction: column;
                align-items: center;
            }
            .form-panel {
                width: 100%;
                max-width: 650px;
            }
            .receipt-panel {
                width: 100%;
            }
        }

        @media print {
            body {
                background: #fff !important;
            }
            body::before {
                display: none !important;
            }
            .site-header,
            .form-panel,
            .print-toolbar,
            .receipt-panel h3,
            .toast {
                display: none !important;
            }
            .main-container {
                display: block !important;
                padding: 0 !important;
                margin: 0 !important;
            }
            .receipt-panel {
                display: block !important;
                width: 100% !important;
                margin: 0 !important;
            }
            #receiptContainer {
                max-width: 100% !important;
                box-shadow: none !important;
                margin: 0 !important;
            }
            #receipt {
                box-shadow: none !important;
                margin: 0 auto !important;
                width: 320px !important;
                background: #fff !important;
                color: #000 !important;
            }
            #receipt.scheme-inverted,
            #receipt.scheme-blue,
            #receipt.scheme-green,
            #receipt.scheme-amber,
            #receipt.scheme-pink {
                background: #fff !important;
                color: #000 !important;
            }
            @page {
                margin: 8mm 6mm;
            }
        }

        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: var(--bg-dark);
        }
        ::-webkit-scrollbar-thumb {
            background: #333355;
            border-radius: 4px;
        }
    </style>
</head>
<body>

    <!-- TOAST NOTIFICATION -->
    <div class="toast" id="toast"></div>

    <!-- HEADER -->
    <header class="site-header">
        <h1>&#9670; RETRO RECEIPT GENERATOR PRO &#9670;</h1>
        <p class="subtitle">// Generate Authentic Dot-Matrix Receipts <span>&#9608;</span></p>
    </header>

    <!-- MAIN CONTENT -->
    <div class="main-container">

        <!-- FORM PANEL -->
        <div class="form-panel">
            <h2>&#9654; CUSTOMIZE YOUR RECEIPT</h2>

            <!-- Store Info -->
            <div class="form-section">
                <label>Receipt Title / Store Name</label>
                <input type="text" id="storeName" value="SILLUEETTE'S CAFE" oninput="renderReceipt()">
            </div>

            <div class="form-row">
                <div class="form-section">
                    <label>Address Line 1</label>
                    <input type="text" id="storeAddress" value="262, CAPITAL OF LILACITH" oninput="renderReceipt()">
                </div>
                <div class="form-section">
                    <label>City</label>
                    <input type="text" id="storeCity" value="LILACITH" oninput="renderReceipt()">
                </div>
            </div>

            <div class="form-section">
                <label>Phone Number</label>
                <input type="text" id="storePhone" value="0135508701" oninput="renderReceipt()">
            </div>

            <!-- Logo Upload -->
            <div class="form-section">
                <label>Upload Logo (PNG, JPG, SVG)</label>
                <input type="file" id="logoInput" accept="image/*" onchange="handleLogoUpload(event)">
                <div class="logo-preview" id="logoPreview"></div>
                <button class="btn btn-danger btn-sm" id="removeLogoBtn" style="display:none;" onclick="removeLogo()">&#10005; Remove Logo</button>
            </div>

            <!-- Order & Host -->
            <div class="form-row">
                <div class="form-section">
                    <label>Order #</label>
                    <input type="text" id="orderNumber" value="1" oninput="renderReceipt()">
                </div>
                <div class="form-section">
                    <label>Host / Cashier</label>
                    <input type="text" id="hostName" value="SILL" oninput="renderReceipt()">
                </div>
            </div>

            <div class="form-row">
                <div class="form-section">
                    <label>Date</label>
                    <input type="text" id="receiptDate" value="15 AUG 2026" oninput="renderReceipt()">
                </div>
                <div class="form-section">
                    <label>Time</label>
                    <input type="text" id="receiptTime" value="12:35 PM" oninput="renderReceipt()">
                </div>
            </div>

            <!-- Items -->
            <div class="form-section">
                <label>Item Name</label>
                <input type="text" id="itemName" value="1 BUST UP SKETCH" oninput="renderReceipt()">
            </div>
            <div class="form-row">
                <div class="form-section">
                    <label>Item Price ($)</label>
                    <input type="number" id="itemPrice" value="15.00" step="0.01" min="0" oninput="renderReceipt()">
                </div>
                <div class="form-section">
                    <label>Tax ($)</label>
                    <input type="number" id="taxAmount" value="0.00" step="0.01" min="0" oninput="renderReceipt()">
                </div>
            </div>

            <!-- Payment Info -->
            <div class="form-row">
                <div class="form-section">
                    <label>Transaction Type</label>
                    <input type="text" id="transactionType" value="SALE" oninput="renderReceipt()">
                </div>
                <div class="form-section">
                    <label>Authorization</label>
                    <input type="text" id="authorization" value="APPROVED" oninput="renderReceipt()">
                </div>
            </div>

            <div class="form-row">
                <div class="form-section">
                    <label>Payment Code</label>
                    <input type="text" id="paymentCode" value="" placeholder="Optional" oninput="renderReceipt()">
                </div>
                <div class="form-section">
                    <label>Card Reader</label>
                    <input type="text" id="cardReader" value="" placeholder="Optional" oninput="renderReceipt()">
                </div>
            </div>

            <!-- Barcode -->
            <div class="form-section">
                <label>Barcode Value</label>
                <input type="text" id="barcodeValue" value="0135508701" oninput="renderReceipt()">
            </div>

            <!-- Footer -->
            <div class="form-section">
                <label>Footer Message</label>
                <textarea id="footerMsg" rows="3" oninput="renderReceipt()">THANKS FOR VISITING DEAR
        LITTLE ANGEL</textarea>
            </div>

            <!-- Color Scheme -->
            <div class="form-section">
                <label>Color Scheme</label>
                <select id="colorScheme" onchange="renderReceipt()">
                    <option value="classic">Classic (Black on Cream)</option>
                    <option value="inverted">Inverted (White on Black)</option>
                    <option value="blue">Vintage Blue</option>
                    <option value="green">Terminal Green</option>
                    <option value="amber">Amber CRT</option>
                    <option value="pink">Retro Pink</option>
                </select>
            </div>

            <!-- Action Buttons -->
            <div class="btn-group">
                <button class="btn btn-primary" onclick="downloadPNG()">&#128190; Download PNG</button>
                <button class="btn btn-info" onclick="printReceipt()">&#128424; Print</button>
                <button class="btn btn-warning" onclick="resetToDefault()">&#8635; Reset</button>
            </div>
        </div>

        <!-- RECEIPT PANEL -->
        <div class="receipt-panel">
            <h3>&#9654; LIVE PREVIEW</h3>

            <div id="receiptContainer">
                <div id="receipt" class="scheme-classic">
                    <!-- Receipt content rendered by JS -->
                </div>
            </div>

            <div class="print-toolbar">
                <button class="btn btn-primary btn-sm" onclick="downloadPNG()">&#128190; PNG</button>
                <button class="btn btn-info btn-sm" onclick="printReceipt()">&#128424; Print</button>
            </div>
        </div>

    </div>

    <script>
        let logoDataUrl = null;

        function escapeHtml(str) {
            return String(str || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function generateDashLine(width) {
            return '-'.repeat(width || 34);
        }

        function generateAsteriskLine(width) {
            return '*'.repeat(width || 36);
        }

        function renderReceipt() {
            const receipt = document.getElementById('receipt');
            const scheme = document.getElementById('colorScheme').value;
            const storeName = document.getElementById('storeName').value || 'SILLUEETTE\'S CAFE';
            const address = document.getElementById('storeAddress').value || '';
            const city = document.getElementById('storeCity').value || '';
            const phone = document.getElementById('storePhone').value || '';
            const orderNum = document.getElementById('orderNumber').value || '1';
            const hostName = document.getElementById('hostName').value || 'SILL';
            const dateVal = document.getElementById('receiptDate').value || '';
            const timeVal = document.getElementById('receiptTime').value || '';
            const itemName = document.getElementById('itemName').value || '1 BUST UP SKETCH';
            const itemPrice = parseFloat(document.getElementById('itemPrice').value) || 0;
            const taxVal = parseFloat(document.getElementById('taxAmount').value) || 0;
            const transactionType = document.getElementById('transactionType').value || 'SALE';
            const authorization = document.getElementById('authorization').value || 'APPROVED';
            const paymentCode = document.getElementById('paymentCode').value || '';
            const cardReader = document.getElementById('cardReader').value || '';
            const barcodeVal = document.getElementById('barcodeValue').value || '0135508701';
            const footerMsgRaw = document.getElementById('footerMsg').value || '';
            const footerLines = footerMsgRaw.split('\n').filter(l => l.trim().length > 0);

            const subtotal = itemPrice;
            const total = subtotal + taxVal;

            const dashLine = generateDashLine(36);
            const asteriskLine = generateAsteriskLine(36);

            let html = '';

            // Top asterisk
            html += `<div class="asterisk-line">${asteriskLine}</div>`;

            // Header section
            html += `<div class="header center" style="margin-top:10px;">`;

            if (logoDataUrl) {
                html += `<img src="${logoDataUrl}" class="logo" alt="Logo">`;
            }

            html += `<div class="mono-header">${escapeHtml(storeName.toUpperCase())}</div>`;
            if (address) html += `<div>${escapeHtml(address)}</div>`;
            if (city) html += `<div>${escapeHtml(city)}</div>`;
            if (phone) html += `<div>${escapeHtml(phone)}</div>`;
            html += `</div>`;

            // Divider
            html += `<div class="divider"></div>`;

            // Order & Host row
            html += `<div class="row"><span>ORDER: ${escapeHtml(orderNum)}</span><span>${escapeHtml(dateVal)}</span></div>`;
            html +=
                `<div class="row"><span>HOST: ${escapeHtml(hostName)}</span><span>${escapeHtml(timeVal)}</span></div>`;

            html += `<div class="spacer-sm"></div>`;
            html += `<div class="divider"></div>`;

            // Item
            html +=
                `<div class="item-row"><span>${escapeHtml(itemName)}</span><span>$ ${itemPrice.toFixed(2)}</span></div>`;

            html += `<div class="spacer-sm"></div>`;
            html += `<div class="divider"></div>`;

            // Payment info
            html += `<div class="row"><span>CASH</span><span>${escapeHtml(transactionType)}</span></div>`;
            html += `<div class="divider"></div>`;

            // Totals
            html += `<div class="row"><span>SUBTOTAL</span><span>$ ${subtotal.toFixed(2)}</span></div>`;
            html += `<div class="row"><span>TAX</span><span>$ ${taxVal.toFixed(2)}</span></div>`;
            html +=
                `<div class="total-row"><span>TOTAL:</span><span>$ ${total.toFixed(2)}</span></div>`;

            // Transaction details
            html +=
                `<div class="row"><span>TRANSACTION TYPE:</span><span>${escapeHtml(transactionType)}</span></div>`;
            html +=
                `<div class="row"><span>AUTHORIZATION:</span><span>${escapeHtml(authorization)}</span></div>`;
            if (paymentCode) {
                html +=
                    `<div class="row"><span>PAYMENT CODE:</span><span>${escapeHtml(paymentCode)}</span></div>`;
            }
            if (cardReader) {
                html +=
                    `<div class="row"><span>CARD READER:</span><span>${escapeHtml(cardReader)}</span></div>`;
            }

            html += `<div class="divider"></div>`;

            // Tip & signature area
            html += `<div class="tip-line"><span>TIP:</span><span>____________________</span></div>`;
            html +=
                `<div class="tip-line" style="margin-top:20px;"><span>TOTAL:</span><span>____________________</span></div>`;
            html +=
                `<div class="signature"><span>X</span><span>____________________</span></div>`;

            html += `<div class="divider"></div>`;

            // Footer
            html += `<div class="footer center">`;
            html += `<div style="font-weight:bold;">CUSTOMER COPY</div>`;
            footerLines.forEach(line => {
                html += `<div>${escapeHtml(line.toUpperCase())}</div>`;
            });
            html += `<div style="margin-top:8px;">${escapeHtml(storeName.toUpperCase())}</div>`;
            html += `</div>`;

            // Barcode area
            html += `<div class="barcode-area">`;
            html +=
                `<svg id="barcodeSvg" class="barcode-svg" jsbarcode-format="CODE128" jsbarcode-value="${escapeHtml(barcodeVal)}" jsbarcode-textmargin="0" jsbarcode-height="50" jsbarcode-width="2"></svg>`;
            html += `<div class="barcode-text">*${escapeHtml(barcodeVal)}*</div>`;
            html += `</div>`;

            // Bottom asterisk
            html += `<div class="asterisk-line" style="margin-top:15px;">${asteriskLine}</div>`;

            receipt.innerHTML = html;
            receipt.className = 'scheme-' + scheme;

            // Generate barcode
            try {
                JsBarcode("#barcodeSvg", barcodeVal, {
                    format: "CODE128",
                    displayValue: false,
                    lineColor: getComputedStyle(receipt).color || '#000',
                    width: 2,
                    height: 50,
                    margin: 0,
                });
            } catch (e) {
                console.log('Barcode error:', e);
            }
        }

        function handleLogoUpload(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    logoDataUrl = e.target.result;
                    updateLogoPreview();
                    renderReceipt();
                };
                reader.readAsDataURL(file);
            }
        }

        function updateLogoPreview() {
            const preview = document.getElementById('logoPreview');
            const removeBtn = document.getElementById('removeLogoBtn');
            if (logoDataUrl) {
                preview.innerHTML = `<img src="${logoDataUrl}" alt="Logo">`;
                removeBtn.style.display = 'inline-block';
            } else {
                preview.innerHTML = '';
                removeBtn.style.display = 'none';
            }
        }

        function removeLogo() {
            logoDataUrl = null;
            document.getElementById('logoInput').value = '';
            updateLogoPreview();
            renderReceipt();
        }

        function downloadPNG() {
            renderReceipt();
            const receipt = document.getElementById('receipt');

            html2canvas(receipt, {
                scale: 3,
                backgroundColor: getComputedStyle(receipt).backgroundColor || '#ffffff',
                useCORS: true,
                allowTaint: true,
                logging: false,
            }).then(canvas => {
                const link = document.createElement('a');
                const storeName = document.getElementById('storeName').value.replace(/\s+/g, '_') || 'receipt';
                link.download = `${storeName}_receipt.png`;
                link.href = canvas.toDataURL("image/png");
                link.click();
                showToast('PNG downloaded successfully!');
            }).catch(err => {
                console.error('Error:', err);
                showToast('Error generating PNG');
            });
        }

        function printReceipt() {
            renderReceipt();
            setTimeout(() => {
                window.print();
            }, 300);
        }

        function resetToDefault() {
            document.getElementById('storeName').value = "SILLUEETTE'S CAFE";
            document.getElementById('storeAddress').value = "262, CAPITAL OF LILACITH";
            document.getElementById('storeCity').value = "LILACITH";
            document.getElementById('storePhone').value = "0135508701";
            document.getElementById('orderNumber').value = "1";
            document.getElementById('hostName').value = "SILL";
            document.getElementById('receiptDate').value = "15 AUG 2026";
            document.getElementById('receiptTime').value = "12:35 PM";
            document.getElementById('itemName').value = "1 BUST UP SKETCH";
            document.getElementById('itemPrice').value = "15.00";
            document.getElementById('taxAmount').value = "0.00";
            document.getElementById('transactionType').value = "SALE";
            document.getElementById('authorization').value = "APPROVED";
            document.getElementById('paymentCode').value = "";
            document.getElementById('cardReader').value = "";
            document.getElementById('barcodeValue').value = "0135508701";
            document.getElementById('footerMsg').value = "THANKS FOR VISITING DEAR\nLITTLE ANGEL";
            document.getElementById('colorScheme').value = "classic";
            logoDataUrl = null;
            document.getElementById('logoInput').value = '';
            updateLogoPreview();
            renderReceipt();
        }

        function showToast(message) {
            const toast = document.getElementById('toast');
            toast.textContent = message;
            toast.classList.add('show');
            setTimeout(() => {
                toast.classList.remove('show');
            }, 2000);
        }

        // Initialize
        window.onload = function() {
            renderReceipt();
        };
    </script>
</body>
</html>
